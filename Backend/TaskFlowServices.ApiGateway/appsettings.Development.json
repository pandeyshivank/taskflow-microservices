{
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning"
        }
    },

    "ReverseProxy": {

        "Routes": {

            "UserRoute": {
                "ClusterId": "UserCluster",
                "Match": {
                    "Path": "/api/User/{**catch-all}"
                }
            },

            "TaskRoute": {
                "ClusterId": "TaskCluster",
                "Match": {
                    "Path": "/api/Task/{**catch-all}"
                }
            },

            "NotificationRoute": {
                "ClusterId": "NotificationCluster",
                "RateLimiterPolicy": "FixedPolicy",
                "Match": {
                    "Path": "/api/Notification/{**catch-all}"
                }
            }

        },

        "Clusters": {

            "UserCluster": {
                "LoadBalancingPolicy": "RoundRobin",
                "Destinations": {
                    "destination1": {
                        "Address": "https://localhost:7180/"
                    },
                    "destination2": {
                        "Address": "https://localhost:7069/"
                    }
                }
            },

            "TaskCluster": {
                "Destinations": {
                    "destination1": {
                        "Address": "https://localhost:7068/"
                    }
                }
            },

            "NotificationCluster": {
                "Destinations": {
                    "destination1": {
                        "Address": "https://localhost:7019/"
                    }
                }
            }

        }

    }
}